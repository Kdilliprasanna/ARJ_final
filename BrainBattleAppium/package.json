{
  "name": "brainbattle-appium",
  "version": "1.0.0",
  "description": "Mobile Appium E2E Automation Suite for BrainBattle (1,111 Android Tests)",
  "main": "wdio.conf.js",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:unit": "node tests/unit/android_unit_tests.js",
    "test:load": "node tests/load/android_load_tests.js",
    "test:ci": "bash scripts/ci_run_tests.sh",
    "report:html": "node utils/generateHtmlReport.js",
    "report:summary": "node utils/generateSummary.js",
    "report:fallback": "node utils/generateFallbackReport.js",
    "report:passed": "node utils/generatePassedExcelReport.js"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "android",
    "e2e",
    "testing",
    "emulator",
    "exceljs"
  ],
  "author": "Kdilliprasanna",
  "license": "ISC",
  "dependencies": {
    "@wdio/cli": "^8.36.0",
    "@wdio/local-runner": "^8.36.0",
    "@wdio/mocha-framework": "^8.36.0",
    "@wdio/spec-reporter": "^8.36.0",
    "appium": "^2.5.4",
    "appium-uiautomator2-driver": "^3.5.0",
    "chai": "^4.4.1",
    "exceljs": "^4.4.0",
    "webdriverio": "^8.36.0"
  }
}
